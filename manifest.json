{
  "id": "mod_manager",
  "name": "Mod Manager",
  "version": "1.0.0",
  "author": "ct",
  "description": "The Mods & Collections screen: what is installed, what each mod does, installing and updating from the online catalog, and which mods make up each ready-made game.",
  "category": "tools, ui",
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": ["tests/*.cs"],
  "depends": ["ui_base>=1"],
  "main_menu": [
    {
      "id": "mods_hub",
      "scene_path": "scenes/mods_hub_screen.tscn",
      "button": { "icon": "mod_manager", "locale": "mod_manager/menu_title", "index": 100 }
    }
  ],
  "test_suites": [
    { "id": "help", "activate": ["--itest=mod_help"] },
    { "id": "documentation", "activate": ["--itest=mod_documentation"] },
    { "id": "collection_settings", "activate": ["--itest=collection_settings"] }
  ]
}
